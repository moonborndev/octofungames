<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.octofun.app-ads-weekly</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>-I</string>
    <string>__REPO__/tools/app-ads-watch/mac/run_panels.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__/tools/app-ads-watch/mac</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <!-- Monday 10:00 local time (Turkey). Weekday: 0 or 7 = Sunday, 1 = Monday. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>1</integer>
    <key>Hour</key>
    <integer>10</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME__/.config/app-ads-watch/logs/weekly.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.config/app-ads-watch/logs/weekly.stderr.log</string>
</dict>
</plist>
