<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.octofun.app-ads-listener</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.config/app-ads-watch/venv/bin/python</string>
    <string>-I</string>
    <string>__REPO__/tools/app-ads-watch/mac/listener.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__/tools/app-ads-watch/mac</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/.config/app-ads-watch/logs/listener.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.config/app-ads-watch/logs/listener.stderr.log</string>
</dict>
</plist>
